<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- iOS apps are always sandboxed; the group is what the share extension will
         use to reach the same library. -->
    <key>com.apple.security.application-groups</key>
    <array><string>group.com.heindewilde.summon</string></array>

    <key>com.apple.developer.icloud-services</key>
    <array><string>CloudKit</string></array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array><string>iCloud.com.heindewilde.summon</string></array>
    <!-- `aps-environment`, not `com.apple.developer.aps-environment`: that is the
         macOS spelling, and iOS drops it silently at signing time — the entitlement
         simply was not in the built app. Release has its own copy of this file with
         `production`, because a production build carrying a development token gets no
         pushes, and sync would then look broken for everyone but the developer. -->
    <key>aps-environment</key><string>production</string>

    <key>keychain-access-groups</key>
    <array><string>$(AppIdentifierPrefix)com.heindewilde.summon</string></array>
</dict>
</plist>
